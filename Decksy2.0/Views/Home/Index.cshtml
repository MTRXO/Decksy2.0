@{
    ViewData["Title"] = "Home";
}

<section class="hero text-center">
    <span class="eyebrow">Flashcards, simplified</span>
    <h1 class="hero-title">Learn faster with Decksy</h1>
    <p class="hero-lead">Create, manage, and review your flashcards in one calm, distraction-free place.</p>
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Flashcards" asp-action="Index" class="btn btn-dark btn-lg">Go to my decks</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-dark btn-lg">Get started</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg">Log in</a>
        }
    </div>
</section>

<section class="section">
    <div class="text-center mb-4">
        <h2 class="section-title">How it works</h2>
        <p class="text-secondary mb-0">Read the word, think of the answer, then reveal it.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3 g-lg-4">
        <div class="col">
            <div class="flashcard">
                <h3 class="flashcard-word">Breeze</h3>
                <p class="flashcard-definition is-hidden">A gentle wind</p>
                <button type="button" class="btn btn-light btn-sm reveal-btn">Reveal</button>
            </div>
        </div>
        <div class="col">
            <div class="flashcard">
                <h3 class="flashcard-word">Spark</h3>
                <p class="flashcard-definition is-hidden">A small flash of light or energy</p>
                <button type="button" class="btn btn-light btn-sm reveal-btn">Reveal</button>
            </div>
        </div>
        <div class="col">
            <div class="flashcard">
                <h3 class="flashcard-word">Nest</h3>
                <p class="flashcard-definition is-hidden">A bird’s home made of twigs</p>
                <button type="button" class="btn btn-light btn-sm reveal-btn">Reveal</button>
            </div>
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="cta text-center">
        <h2 class="section-title">Start learning today</h2>
        <p class="text-secondary mb-4">Sign up for free and build your first deck in minutes.</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-dark btn-lg">Create account</a>
    </section>
}

@section Scripts {
    <script>
        document.querySelectorAll('.reveal-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const definition = btn.previousElementSibling;
                const hidden = definition.classList.toggle('is-hidden');
                btn.textContent = hidden ? 'Reveal' : 'Hide';
            });
        });
    </script>
}
