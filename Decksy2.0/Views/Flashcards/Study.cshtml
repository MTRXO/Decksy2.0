@model DecksyModel
@{
    ViewData["Title"] = "Study: " + Model.Name;
    var cards = Model.Flashcards.Select(c => new { word = c.Word, definition = c.Definition });
}

<a asp-action="Deck" asp-route-id="@Model.Id" class="back-link">&larr; Back to @Model.Name</a>

<div class="study">
    <div class="study-top">
        <span class="text-secondary small" id="studyCounter"></span>
        <button type="button" class="btn btn-light btn-sm" id="shuffleBtn">Shuffle</button>
    </div>
    <div class="study-progress"><div class="study-progress-bar" id="progressBar"></div></div>

    <div id="studySession">
        <div class="study-stack" id="studyStack">
            <div class="study-card" id="studyCard" role="button" tabindex="0" aria-live="polite">
                <span class="study-word" id="cardWord"></span>
                <div class="study-answer">
                    <div class="study-answer-inner">
                        <span class="study-divider"></span>
                        <span class="study-definition" id="cardDefinition"></span>
                    </div>
                </div>
                <span class="study-hint">Tap the card or press Space to reveal</span>
            </div>
        </div>

        <div class="study-actions" id="revealActions">
            <button type="button" class="btn btn-dark btn-lg" id="revealBtn">Show answer <kbd>Space</kbd></button>
        </div>
        <div class="study-actions study-actions-grade" id="gradeActions" hidden>
            <button type="button" class="btn btn-light btn-lg btn-again" id="againBtn">&larr; Still learning <kbd>1</kbd></button>
            <button type="button" class="btn btn-light btn-lg btn-know" id="knowBtn">I know it &rarr; <kbd>2</kbd></button>
        </div>
    </div>

    <div id="studySummary" class="study-summary surface" hidden>
        <div class="empty-icon">🎉</div>
        <h2 class="h4">Round complete</h2>
        <p class="text-secondary" id="summaryText"></p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <button type="button" class="btn btn-dark" id="reviewMissedBtn">Review missed cards</button>
            <button type="button" class="btn btn-light" id="restartBtn">Start over</button>
            <a asp-action="Deck" asp-route-id="@Model.Id" class="btn btn-light">Back to deck</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const allCards = @Json.Serialize(cards);
            const el = id => document.getElementById(id);
            const card = el('studyCard');
            const stack = el('studyStack');
            const exitDuration = 320;

            let queue = [];
            let index = 0;
            let known = 0;
            let missed = [];
            let revealed = false;
            let busy = false;

            function start(cards) {
                queue = [...cards];
                index = 0;
                known = 0;
                missed = [];
                busy = false;
                el('studySession').hidden = false;
                el('studySummary').hidden = true;
                render();
            }

            function render() {
                const current = queue[index];
                setRevealed(false);
                el('cardWord').textContent = current.word;
                el('cardDefinition').textContent = current.definition;
                el('studyCounter').textContent = `Card ${index + 1} of ${queue.length}`;
                el('progressBar').style.width = `${(index / queue.length) * 100}%`;
                stack.dataset.remaining = Math.min(queue.length - index - 1, 2);

                card.classList.remove('exit-left', 'exit-right');
                card.classList.add('enter');
                void card.offsetWidth; // apply the start position before animating in
                card.classList.remove('enter');
            }

            function setRevealed(value) {
                revealed = value;
                card.classList.toggle('is-revealed', revealed);
                el('revealActions').hidden = revealed;
                el('gradeActions').hidden = !revealed;
            }

            function reveal() {
                if (!busy && !revealed) setRevealed(true);
            }

            function answer(knewIt) {
                if (!revealed || busy) return;
                busy = true;
                if (knewIt) known++; else missed.push(queue[index]);
                card.classList.add(knewIt ? 'exit-right' : 'exit-left');

                setTimeout(() => {
                    busy = false;
                    index++;
                    if (index < queue.length) {
                        render();
                    } else {
                        finish();
                    }
                }, exitDuration);
            }

            function finish() {
                el('progressBar').style.width = '100%';
                el('studyCounter').textContent = `${queue.length} of ${queue.length}`;
                el('studySession').hidden = true;
                el('studySummary').hidden = false;
                el('summaryText').textContent = `You knew ${known} of ${queue.length} cards.`
                    + (missed.length ? ` ${missed.length} still ${missed.length === 1 ? 'needs' : 'need'} practice.` : ' Perfect score!');
                el('reviewMissedBtn').hidden = missed.length === 0;
            }

            function shuffle(cards) {
                const copy = [...cards];
                for (let i = copy.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [copy[i], copy[j]] = [copy[j], copy[i]];
                }
                return copy;
            }

            card.addEventListener('click', reveal);
            el('revealBtn').addEventListener('click', reveal);
            el('againBtn').addEventListener('click', () => answer(false));
            el('knowBtn').addEventListener('click', () => answer(true));
            el('shuffleBtn').addEventListener('click', () => start(shuffle(allCards)));
            el('restartBtn').addEventListener('click', () => start(allCards));
            el('reviewMissedBtn').addEventListener('click', () => start(missed));

            document.addEventListener('keydown', e => {
                if (el('studySession').hidden) return;
                if (e.code === 'Space' || (e.key === 'Enter' && e.target === card)) { e.preventDefault(); reveal(); }
                if (e.key === '1' || e.key === 'ArrowLeft') answer(false);
                if (e.key === '2' || e.key === 'ArrowRight') answer(true);
            });

            start(allCards);
        })();
    </script>
}
