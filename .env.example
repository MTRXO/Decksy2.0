# Copy this file to .env on the server and fill in real values.

# Your domain, already pointing (DNS A record) at the server's IP.
DOMAIN=decksy.example.com

# New, strong password for the database (not used anywhere else).
# At least 8 characters with upper- and lower-case letters, digits and a symbol.
# Do NOT use ; ' " $ or spaces - they break the connection string or the .env file.
DB_PASSWORD=ChangeMe_Str0ng_Passw0rd
