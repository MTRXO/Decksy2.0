@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-card">
    <h1>Welcome back</h1>
    <p class="text-secondary mb-4">Log in to continue with your decks.</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
            <label asp-for="Input.Password" class="form-label">Password</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" id="rememberMe">
                <label class="form-check-label" for="rememberMe">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>
            @* Hidden until the app can send e-mails:
            <a id="forgot-password" asp-page="./ForgotPassword" class="small">Forgot password?</a> *@
        </div>
        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-dark">Log in</button>
    </form>

    <div class="auth-links text-center">
        <span class="text-secondary">
            No account?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-medium text-body">Sign up</a>
        </span>
        @* Hidden until the app can send e-mails:
        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a> *@
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
